{
  "$schema": "./node_modules/zonedb-cli/config.schema.json",
  "collection": "products",
  "input": {
    "path": "data/products.csv",
    "format": "csv"
  },
  "blockBytes": 16384,
  "schema": {
    "sortField": "price",
    "pk": "sku",
    "fields": {
      "sku": { "kind": "string", "indexed": true },
      "name": { "kind": "string", "indexed": true },
      "category": {
        "kind": "string",
        "indexed": true,
        "values": ["Electronics", "Fitness", "Garden", "Kitchen", "Office", "Outdoors", "Stationery", "Toys"]
      },
      "price": { "kind": "number" },
      "inStock": { "kind": "boolean", "indexed": true },
      "discountPct": { "kind": "number", "indexed": true, "absent": true }
    }
  }
}
