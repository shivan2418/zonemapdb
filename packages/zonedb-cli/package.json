{
  "name": "zonedb-cli",
  "version": "0.7.0",
  "description": "Build tool for zonedb: infer → partition → index → codegen + config wizard.",
  "type": "module",
  "license": "MIT",
  "author": "Emil Elgaard",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zonedb": "./dist/bin.js"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivan2418/blockdb.git",
    "directory": "packages/zonedb-cli"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "zonedb": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run --json"
  }
}
