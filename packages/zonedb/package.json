{
  "name": "zonedb",
  "version": "0.7.0",
  "description": "Query large static datasets from any static host — partitioned into many small files, typed client, no WASM, no HTTP Range.",
  "type": "module",
  "license": "MIT",
  "author": "Emil Elgaard",
  "keywords": [
    "static",
    "database",
    "partitioning",
    "query",
    "large-data",
    "browser",
    "static-site",
    "typescript",
    "typed",
    "codegen",
    "cdn",
    "no-backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivan2418/blockdb.git",
    "directory": "packages/zonedb"
  },
  "homepage": "https://github.com/shivan2418/blockdb#readme",
  "bugs": "https://github.com/shivan2418/blockdb/issues",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "zonedb-cli": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run --json"
  }
}
